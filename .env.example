# Copy file này thành `.env` rồi điền giá trị thật. docker compose tự đọc `.env`.
# Các biến SECRET để trống có chủ đích: compose báo lỗi nếu chưa điền, không có secret công khai.

# ===== Spring profile =====
# docker-compose.yml đã set sẵn SPRING_PROFILES_ACTIVE=prod cho service app.
# Chạy tay (java -jar / spring-boot:run) phải export biến này, nếu không app chỉ là bản local-dev.
SPRING_PROFILES_ACTIVE=prod

# ===== Database container (docker compose) =====
# Mật khẩu root MySQL - BẮT BUỘC. Tự sinh, ví dụ: openssl rand -base64 24
DB_ROOT_PASSWORD=
# Tên database (không phải secret, compose có fallback)
DB_NAME=audiotour_db

# ===== Database cho profile prod (application-prod.yml, KHÔNG có giá trị mặc định) =====
DB_USERNAME=root
# Tự sinh: openssl rand -base64 24
DB_PASSWORD=

# ===== JWT (application-prod.yml không có giá trị mặc định) =====
# BẮT BUỘC, tối thiểu 32 byte. Tự sinh: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ===== Tài khoản admin (application-prod.yml không có giá trị mặc định) =====
# BẮT BUỘC, tối thiểu 3 ký tự
APP_ADMIN_USERNAME=
# BẮT BUỘC. Tự sinh mật khẩu mạnh, KHÔNG dùng admin123
APP_ADMIN_PASSWORD=

# ===== TTS (ElevenLabs) - sinh file MP3 từ textContent =====
# Không bắt buộc: để trống thì app vẫn chạy, POST /api/narrations/{id}/audio trả 503.
# Free tier: 10.000 ký tự/tháng, phải ghi công elevenlabs.io khi công bố audio.
ELEVENLABS_API_KEY=
# Một voice ID dùng chung cho mọi ngôn ngữ. BẮT BUỘC điền: voice thư viện (Rachel...) bị free tier chặn qua API.
# Tạo voice riêng tại elevenlabs.io -> Voices -> Voice Design (free tier có 3 slot), rồi copy voice ID.
TTS_VOICE=
# Tiếng Việt không có trong eleven_multilingual_v2, đừng đổi sang model đó
TTS_MODEL_ID=eleven_flash_v2_5

# ===== Dịch máy (DeepL Free) - thêm ngôn ngữ mới =====
# Không bắt buộc để app chạy; thiếu key thì POST /api/languages/{code}/translate trả 503.
# Free tier: 500.000 ký tự/tháng, không cần thẻ. Pro plan đổi base URL thành https://api.deepl.com
DEEPL_API_KEY=
DEEPL_BASE_URL=https://api-free.deepl.com
